@model btlWorkGate_SanGiaoDichViecLam.Models.TinTuyenDungViewModel
@{
    ViewBag.Title = "Đăng tin tuyển dụng mới";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    body, html {
        margin: 0 !important;
        padding: 0 !important;
    }
    .post-job-form {
        max-width: 800px;
        margin: 20px auto;
        background: white;
        padding: 20px 40px;
        border-radius: 12px;
        box-shadow: 0 4px 20px rgba(0,0,0,0.08);
    }

    .form-title {
        text-align: center;
        margin-bottom: 30px;
        color: #1e3a8a;
    }

    .form-row {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 20px;
        margin-bottom: 20px;
    }

    .form-group {
        margin-bottom: 20px;
    }

        .form-group label {
            display: block;
            font-weight: 600;
            margin-bottom: 8px;
            color: #374151;
        }

    .form-control {
        width: 100%;
        padding: 12px 16px;
        border: 1.5px solid #d1d5db;
        border-radius: 8px;
        font-size: 16px;
        transition: all 0.3s;
    }

        .form-control:focus {
            border-color: #3b82f6;
            box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.1);
            outline: none;
        }

        .form-control::placeholder {
            color: #9ca3af;
        }

    .full-width {
        grid-column: 1 / -1;
    }

    .btn-group {
        display: flex;
        gap: 15px;
        margin-top: 30px;
    }

    .btn-submit {
        background: #2563eb;
        color: white;
        padding: 14px 32px;
        border: none;
        border-radius: 8px;
        font-size: 16px;
        font-weight: 600;
        cursor: pointer;
        flex: 1;
    }

    .btn-cancel {
        background: #e5e7eb;
        color: #374151;
        padding: 14px 32px;
        border: none;
        border-radius: 8px;
        font-size: 16px;
        font-weight: 600;
        cursor: pointer;
        flex: 1;
    }

    .btn-submit:disabled {
        background: #93c5fd;
        cursor: not-allowed;
    }

    .error {
        color: #ef4444;
        font-size: 13px;
        margin-top: 5px;
    }
</style>

<div class="post-job-form">
    <h2 class="form-title">Đăng tin tuyển dụng</h2>

    @using (Html.BeginForm("yeuCauDangTin", "TinTuyenDung", FormMethod.Post, new { id = "formDangTin" }))
    {
        @Html.AntiForgeryToken()

        <div class="form-row">
            <!-- Vị trí -->
            <div class="form-group full-width">
                <label>Vị trí tuyển dụng</label>
                @Html.TextBoxFor(m => m.sViTriCV, new { @class = "form-control", id = "viTri", placeholder = "VD: Lập trình viên Front-End" })
                <div id="errViTri" class="error"></div>
            </div>
        </div>

        <div class="form-row">
            <!-- Địa điểm -->
            <div class="form-group">
                <label>Địa điểm</label>
                @Html.TextBoxFor(m => m.sDiaDiem, new { @class = "form-control", id = "diaDiem", placeholder = "Hà Nội" })
                <div id="errDiaDiem" class="error"></div>
            </div>

            <!-- Mức lương -->
            <div class="form-group">
                <label>Mức lương</label>
                @Html.TextBoxFor(m => m.fMucLuong, new { @class = "form-control", id = "luong", type = "text", placeholder = "10-15 triệu" })
                <div id="errLuong" class="error"></div>
            </div>
        </div>

        <div class="form-row">
            <!-- Số lượng -->
            <div class="form-group">
                <label>Số lượng</label>
                @Html.TextBoxFor(m => m.iSoLuong, new { @class = "form-control", id = "soLuong", type = "number", placeholder = "1" })
                <div id="errSoLuong" class="error"></div>
            </div>

            <!-- Hạn nộp -->
            <div class="form-group">
                <label>Hạn nộp hồ sơ</label>
                @Html.TextBoxFor(m => m.dHanNop, new { @class = "form-control", id = "hanNop", type = "date" })
                <div id="errHanNop" class="error"></div>
            </div>
        </div>

        <!-- Mô tả công việc -->
        <div class="form-group full-width">
            <label>Mô tả công việc</label>
            @Html.TextAreaFor(m => m.tMoTaCV, new { @class = "form-control", id = "moTa", rows = "5", placeholder = "Mô tả chi tiết về công việc..." })
            <div id="errMoTa" class="error"></div>
        </div>

        <!-- Yêu cầu ứng viên -->
        <div class="form-group full-width">
            <label>Yêu cầu ứng viên</label>
            @Html.TextAreaFor(m => m.sYeuCauChuyenMon, new { @class = "form-control", id = "yeuCau", rows = "5", placeholder = "Các yêu cầu về kinh nghiệm, kỹ năng..." })
            <div id="errYeuCau" class="error"></div>
        </div>

        <div class="btn-group">
            <button type="button" onclick="history.back()" class="btn-cancel">Hủy</button>
            <button type="button" id="btnDangTin" class="btn-submit" disabled>Đăng tin</button>
        </div>
    }
</div>

@section Scripts {
    <script src="~/Scripts/dangtin.js"></script>
}