@model IEnumerable<btlWorkGate_SanGiaoDichViecLam.Models.TinTuyenDung>

@{
    ViewBag.Title = "Tin tuyển dụng của tôi";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid py-4">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold mb-0">Tin tuyển dụng của tôi</h2>
        <a href="@Url.Action("vDangTin", "TinTuyenDung")" class="btn btn-primary px-4 py-2">
            <i class="bi bi-plus-lg"></i> Đăng tin mới
        </a>
    </div>

    <!-- Filter -->
    <div class="row mb-4">
        <div class="col-md-4">
            <div class="form-group">
                <label class="form-label fw-medium">Trạng thái:</label>
                <select id="filterStatus" class="form-select">
                    <option value="">Tất cả</option>
                    <option value="Dang hoat dong">Đang hoạt động</option>
                    <option value="Cho duyet">Chờ duyệt</option>
                    <option value="Het han">Hết hạn</option>
                </select>
            </div>
        </div>
    </div>

    <!-- Danh sách tin tuyển dụng -->
    <div id="jobList" class="row g-3">
        @if (Model != null && Model.Any())
        {
            foreach (var tin in Model)
            {
                <div class="col-12">
                    <div class="job-card border rounded-3 p-4 bg-white shadow-sm">
                        <div class="d-flex justify-content-between align-items-start">
                            <!-- Thông tin chính -->
                            <div class="flex-grow-1">
                                <h5 class="fw-bold mb-2">@tin.sViTriCV</h5>
                                <div class="text-muted mb-3">
                                    @tin.sDiaDiem
                                    <span class="mx-2">•</span>
                                    @if (tin.fMucLuong.HasValue)
                                    {
                                        <span>@tin.fMucLuong.Value - @(tin.fMucLuong.Value + 3) triệu</span>
                                    }
                                    <span class="mx-2">•</span>
                                    Hạn nộp: <strong>@tin.dHanNop.ToString("dd/MM/yyyy")</strong>
                                </div>

                                <div class="d-flex align-items-center gap-4 text-muted small">
                                    <span><i class="bi bi-eye"></i> 156 lượt xem</span>
                                    <span><i class="bi bi-people"></i> @tin.iSoLuong ứng viên</span>
                                </div>
                            </div>

                            <!-- Trạng thái + Button -->
                            <div class="text-end">
                                @if (tin.sTrangThaiTin == "Dang hoat dong")
                                {
                                    <span class="badge bg-success px-3 py-2">Đang hoạt động</span>
                                }
                                else if (tin.sTrangThaiTin == "Cho duyet")
                                {
                                    <span class="badge bg-warning text-dark px-3 py-2">Chờ duyệt</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary px-3 py-2">@tin.sTrangThaiTin</span>
                                }

                                <div class="mt-3 d-flex flex-column gap-2">
                                    <a href="#" class="btn btn-outline-primary btn-sm">Xem ứng viên</a>
                                    <div class="d-flex gap-2 justify-content-end">
                                        <button class="btn btn-light btn-sm"><i class="bi bi-pencil"></i></button>
                                        <button class="btn btn-light btn-sm"><i class="bi bi-three-dots"></i></button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12 text-center py-5">
                <p class="text-muted">Bạn chưa có tin tuyển dụng nào. Hãy đăng tin đầu tiên!</p>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        // Lọc theo trạng thái (demo)
        $("#filterStatus").on("change", function () {
            let status = $(this).val();
            $(".job-card").each(function () {
                if (!status) {
                    $(this).parent().show();
                } else {
                    let cardStatus = $(this).find(".badge").text().trim();
                    if (cardStatus === status) {
                        $(this).parent().show();
                    } else {
                        $(this).parent().hide();
                    }
                }
            });
        });
    </script>
}