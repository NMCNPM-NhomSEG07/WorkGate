@model IEnumerable<btlWorkGate_SanGiaoDichViecLam.Models.TinTuyenDung>

@{
    ViewBag.Title = "Tin tuyển dụng của tôi";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    body {
        background-color: #f8fafc;
        font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
    }

    h2 {
        font-size: 28px;
        font-weight: 700;
        color: #1f2937;
        margin: 0;
    }

    .header-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 24px;
    }

    .btn-primary {
        background: #2563eb;
        color: white;
        border: none;
        border-radius: 9999px;
        font-weight: 600;
        padding: 10px 24px;
        font-size: 15px;
    }

    .form-select {
        border-radius: 8px;
        border: 1px solid #d1d5db;
        padding: 10px 14px;
        font-size: 15px;
    }

    .job-card {
        background: #ffffff;
        border: 1px solid #e5e7eb;
        border-radius: 16px;
        padding: 24px 28px;
        transition: all 0.25s ease;
        margin-bottom: 20px;
    }

        .job-card:hover {
            box-shadow: 0 8px 20px rgba(0, 0, 0, 0.07);
            border-color: #d1d5db;
        }

        .job-card h5 {
            font-size: 20px;
            font-weight: 700;
            color: #111827;
            margin: 0;
        }

    .job-info {
        color: #6b7280;
        font-size: 15px;
        margin-top: 8px;
    }

    .job-stats {
        color: #6b7280;
        font-size: 14.5px;
        margin-top: 12px;
    }

    .card-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 20px;
    }

    .actions {
        display: flex;
        align-items: center;
        gap: 8px;
        flex-shrink: 0;
        margin-top: 2px;
    }

    .badge {
        font-size: 13.5px;
        font-weight: 600;
        padding: 6px 16px;
        border-radius: 9999px;
        white-space: nowrap;
    }

        .badge.bg-success {
            background-color: #d1fae5 !important;
            color: #065f46 !important;
        }

        .badge.bg-warning {
            background-color: #fef3c7 !important;
            color: #92400e !important;
        }

        .badge.bg-secondary {
            background-color: #e5e7eb !important;
            color: #374151 !important;
        }

    .btn-outline-primary {
        border: 1px solid #2563eb;
        color: #2563eb;
        border-radius: 8px;
        font-weight: 500;
        padding: 6px 18px;
        font-size: 14px;
        white-space: nowrap;
    }

    .btn-light {
        width: 38px;
        height: 38px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border: 1px solid #e5e7eb;
        border-radius: 8px;
        color: #6b7280;
    }

    .btn-danger {
        width: 38px;
        height: 38px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border: 1px solid #e5e7eb;
        border-radius: 8px;
        color: #ef4444;
    }

        .btn-light:hover, .btn-danger:hover {
            background-color: #f3f4f6;
        }

        .btn-danger:hover {
            background-color: #fee2e2;
            color: #dc2626;
        }
</style>

<div class="container-fluid py-4">
    @Html.AntiForgeryToken()
    <div class="header-row">
        <h2>Tin tuyển dụng của tôi</h2>
        <a href="@Url.Action("vDangTin", "TinTuyenDung")" class="btn btn-primary">
            <i class="bi bi-plus-lg"></i> Đăng tin mới
        </a>
    </div>

    <div class="row mb-4">
        <div class="col-md-3">
            <label class="form-label fw-medium text-muted mb-1">Trạng thái:</label>
            <select id="filterStatus" class="form-select">
                <option value="">Tất cả</option>
                <option value="Đang hoạt động">Đang hoạt động</option>
                <option value="Chờ duyệt">Chờ duyệt</option>
                <option value="Hết hạn">Hết hạn</option>
            </select>
        </div>
    </div>

    <div id="jobList" class="row g-5">
        @if (Model != null && Model.Any())
        {
            foreach (var tin in Model)
            {
                // Logic trạng thái hiển thị
                string displayStatus = tin.sTrangThaiTin;
                string badgeClass = "bg-secondary";

                if (tin.dHanNop < DateTime.Today)
                {
                    displayStatus = "Hết hạn";
                    badgeClass = "bg-secondary";
                }
                else if (tin.sTrangThaiTin == "Đã duyệt" || tin.sTrangThaiTin == "Dang hoat dong" || tin.sTrangThaiTin == "Đang hoạt động")
                {
                    displayStatus = "Đang hoạt động";
                    badgeClass = "bg-success";
                }
                else if (tin.sTrangThaiTin == "Chờ duyệt" || tin.sTrangThaiTin == "Cho duyet")
                {
                    displayStatus = "Chờ duyệt";
                    badgeClass = "bg-warning";
                }

                <div class="col-12 job-item" data-status="@displayStatus">
                    <div class="job-card">
                        <div class="card-header">
                            <div>
                                <h5>@tin.sViTriCV</h5>
                                <div class="job-info">
                                    @tin.sDiaDiem
                                    <span class="mx-2">•</span>
                                    @if (tin.fMucLuong.HasValue)
                                    {
                                        <span>@tin.fMucLuong.Value.ToString("0") - @(tin.fMucLuong.Value + 3) triệu</span>
                                    }
                                    else
                                    {
                                        <span>Thỏa thuận</span>
                                    }
                                    <span class="mx-2">•</span>
                                    Hạn nộp: <strong>@tin.dHanNop.ToString("dd/MM/yyyy")</strong>
                                </div>
                                <div class="job-stats">
                                    <span><i class="bi bi-eye"></i> 156 lượt xem</span>
                                    <span class="mx-3"><i class="bi bi-people-fill"></i> <strong id="slungvien-@tin.PK_sMaTin">@tin.iSoUngVien</strong> ứng viên</span>
                                </div>
                            </div>

                            <div class="actions">
                                <span class="badge @badgeClass">@displayStatus</span>
                                <button onclick="xemUngVien('@tin.PK_sMaTin')" class="btn btn-outline-primary btn-sm">
                                    Xem ứng viên
                                </button>
                                <button onclick="chinhSuaTin('@tin.PK_sMaTin')" class="btn btn-light" title="Chỉnh sửa">
                                    <i class="bi bi-pencil"></i>
                                </button>
                                <button onclick="xoaTin('@tin.PK_sMaTin')" class="btn btn-danger" title="Xóa tin">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12 text-center py-5">
                <p class="text-muted fs-5">Bạn chưa có tin tuyển dụng nào. Hãy đăng tin đầu tiên!</p>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        // Filter trạng thái
        $("#filterStatus").on("change", function () {
            let status = $(this).val();
            if (!status) $(".job-item").show();
            else $(".job-item").each(function () {
                $(this).toggle($(this).data("status") === status);
            });
        });

        function xemUngVien(maTin) {
            window.location.href = '@Url.Action("vDanhSachUngVien", "TinTuyenDung")?maTin=' + maTin;
        }

        function chinhSuaTin(maTin) {
            window.location.href = '@Url.Action("vChinhSuaTin", "TinTuyenDung")?maTin=' + maTin;
        }

        function xoaTin(maTin) {
            let token = $('input[name="__RequestVerificationToken"]').val();
            $.ajax({
                url: '@Url.Action("xoaTinVinhVien", "TinTuyenDung")',
                type: 'POST',
                data: {
                    __RequestVerificationToken: token,
                    maTin: maTin
                },
                success: function (res) {
                    if (res.success) {
                        alert(res.message);
                        location.reload();
                    } else {
                        alert(res.message);
                    }
                },
                error: function () {
                    alert("Lỗi kết nối, không thể xóa tin.");
                }
            });
        }
    </script>
}